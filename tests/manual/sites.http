@baseUrl = http://localhost:5000/logbook
@missingId = 665000000000000000000000

### CREATE (POST)

### POST - valid site (201 Created)
# @name createSite
POST {{baseUrl}}/sites
Content-Type: application/json

{
    "name": "Test Wreck",
    "country": "Ireland",
    "maxDepth": 30,
    "siteType": "wreck",
    "difficulty": "intermediate"
}

