###
@diveId = {{createDive.response.body._id}}

### POST - fails validation: missing required fields (400)
POST {{baseUrl}}/dives
Content-Type: application/json

{
    "notes": "No date, site, depth or duration"
}

### POST - fails validation: date in the future (400)
POST {{baseUrl}}/dives
Content-Type: application/json

{
    "date": "2030-01-01T10:00:00Z",
    "site": "{{siteId}}",
    "maxDepth": 10,
    "duration": 30
}

### POST - fails validation: rating out of range and negative duration (400)
POST {{baseUrl}}/dives
Content-Type: application/json

{
    "date": "2026-05-01T10:00:00Z",
    "site": "{{siteId}}",
    "maxDepth": 10,
    "duration": -5,
    "rating": 6
}

### POST - fails validation: sighting with an empty name (400)
POST {{baseUrl}}/dives
Content-Type: application/json

{
    "date": "2026-05-01T10:00:00Z",
    "site": "{{siteId}}",
    "maxDepth": 10,
    "duration": 30,
    "sightings": [{ "name": "" }]
}

### POST - fails validation: site id has the wrong format (400)
POST {{baseUrl}}/dives
Content-Type: application/json

{
    "date": "2026-05-01T10:00:00Z",
    "site": "abc",
    "maxDepth": 10,
    "duration": 30
}

### POST - site does not exist (400)
POST {{baseUrl}}/dives
Content-Type: application/json

{
    "date": "2026-05-01T10:00:00Z",
    "site": "{{missingId}}",
    "maxDepth": 10,
    "duration": 30
}

### POST - dive deeper than the site's max depth, 30 m at a 25 m site (400)
POST {{baseUrl}}/dives
Content-Type: application/json

{
    "date": "2026-05-01T10:00:00Z",
    "site": "{{siteId}}",
    "maxDepth": 30,
    "duration": 30
}

### READ (GET)

### GET - all dives, newest first, each with site name and country (200)
GET {{baseUrl}}/dives

### GET - filter by sighting, partial and case-insensitive: finds "grey seal" (200)
GET {{baseUrl}}/dives?sighting=SEAL

### GET - filter by sighting: octopus (200)
GET {{baseUrl}}/dives?sighting=octopus

### GET - dives 30 m or deeper (200)
GET {{baseUrl}}/dives?minDepth=30

### GET - depth range 10 to 20 m (200)
GET {{baseUrl}}/dives?minDepth=10&maxDepth=20

### GET - date range: summer 2026 (200)
GET {{baseUrl}}/dives?from=2026-06-01&to=2026-08-31

### GET - only dives rated 5 (200)
GET {{baseUrl}}/dives?minRating=5

### GET - dives at one site (200)
GET {{baseUrl}}/dives?site={{siteId}}

### GET - combined: seal dives rated 5 (200)
GET {{baseUrl}}/dives?sighting=seal&minRating=5

### GET - sort by depth, deepest first (200)
GET {{baseUrl}}/dives?sort=-maxDepth

### GET - sort by duration, shortest first (200)
GET {{baseUrl}}/dives?sort=duration

### GET - invalid site id in the filter (400)
GET {{baseUrl}}/dives?site=abc

### GET - one dive that exists, with full site details (200)
GET {{baseUrl}}/dives/{{diveId}}

### GET - one dive that doesn't exist (404)
GET {{baseUrl}}/dives/{{missingId}}

### GET - invalid id format (400)
GET {{baseUrl}}/dives/abc

### GET - all dives at a site (200)
GET {{baseUrl}}/sites/{{siteId}}/dives

### GET - dives at a site that doesn't exist (404)
GET {{baseUrl}}/sites/{{missingId}}/dives

### RELATIONSHIP RULE

### DELETE - a site that still has dives logged at it (409)
DELETE {{baseUrl}}/sites/{{siteId}}

### UPDATE (PUT)

### PUT - valid update (200)
PUT {{baseUrl}}/dives/{{diveId}}
Content-Type: application/json

{
    "date": "2026-10-01T10:00:00Z",
    "site": "{{siteId}}",
    "maxDepth": 17,
    "duration": 50,
    "waterTemp": 12,
    "visibility": 6,
    "rating": 4,
    "notes": "Updated: actually saw a third seal",
    "sightings": [
        { "name": "Grey Seal", "count": 3 },
        { "name": "Octopus" }
    ]
}

### PUT - dive not found (404)
PUT {{baseUrl}}/dives/{{missingId}}
Content-Type: application/json

{
    "date": "2026-10-01T10:00:00Z",
    "site": "{{siteId}}",
    "maxDepth": 10,
    "duration": 30
}

### PUT - fails validation: duration too long (400)
PUT {{baseUrl}}/dives/{{diveId}}
Content-Type: application/json

{
    "date": "2026-10-01T10:00:00Z",
    "site": "{{siteId}}",
    "maxDepth": 10,
    "duration": 500
}

### PUT - deeper than the site allows (400)
PUT {{baseUrl}}/dives/{{diveId}}
Content-Type: application/json

{
    "date": "2026-10-01T10:00:00Z",
    "site": "{{siteId}}",
    "maxDepth": 30,
    "duration": 40
}

### DELETE

### DELETE - dive that exists (204)
DELETE {{baseUrl}}/dives/{{diveId}}

### DELETE - same dive again, now gone (404)
DELETE {{baseUrl}}/dives/{{diveId}}

### DELETE - invalid id format (400)
DELETE {{baseUrl}}/dives/abc
