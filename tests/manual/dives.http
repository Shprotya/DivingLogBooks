@baseUrl = http://localhost:5000/logbook
@missingId = 665000000000000000000000

### SETUP - the site test dives are logged at
### Dalkey Island (max depth 25 m)
@siteId = 6aca99d3625ea0ef88f87fb4

@dalkeyId = 6aca99d3625ea0ef88f87fb4
@loughHyneId = 6aca9dd1625ea0ef88f87fb8
@skelligId = 6aca9dd4625ea0ef88f87fb9
@kilkeeId = 6aca9dd7625ea0ef88f87fba
@umElFaroudId = 6aca9dd9625ea0ef88f87fbb
@santaMariaId = 6aca9ddb625ea0ef88f87fbc
@thistlegormId = 6aca9dde625ea0ef88f87fbd
@rasMohammedId = 6aca9ddf625ea0ef88f87fbe



### CREATE (POST)

### POST - valid dive (201). Sighting names come back in lowercase, count defaults to 1.
# @name createDive
POST {{baseUrl}}/dives
Content-Type: application/json

{
    "date": "2026-10-01T10:00:00Z",
    "site": "{{siteId}}",
    "maxDepth": 15,
    "duration": 45,
    "waterTemp": 12,
    "visibility": 6,
    "rating": 3,
    "notes": "Test dive from dives.http",
    "sightings": [
        { "name": "Grey Seal", "count": 2 },
        { "name": "OCTOPUS" }
    ]
}

### CREATE DIVES (all depths are within each site's max depth)

### Dalkey Island, April 2026
POST {{baseUrl}}/dives
Content-Type: application/json

{
    "date": "2026-04-12T11:00:00Z",
    "site": "{{dalkeyId}}",
    "maxDepth": 14,
    "duration": 50,
    "waterTemp": 10,
    "visibility": 6,
    "rating": 4,
    "notes": "Cold but calm, seals came close at the safety stop",
    "sightings": [
        { "name": "Grey Seal", "count": 3 },
        { "name": "Ballan Wrasse", "count": 2 }
    ]
}

